#!/bin/sh
# rdebugger-setup - station provisioning and runtime configuration.
#
#   rdebugger-setup boot    run once per boot by rdebugger-setup.service:
#                           import provisioning files from the boot partition,
#                           set the hostname and generate runtime configuration
#   rdebugger-setup apply   the same, then restart the affected services; use
#                           after editing /etc/rdebugger/station.conf
#   rdebugger-setup show    print the effective configuration
#
# Runs under busybox ash: only busybox applets (no install, no GNU options).
#
# Configuration = /usr/lib/rdebugger/station.defaults overridden by
# /etc/rdebugger/station.conf. Files are parsed, never sourced: only the
# known KEY="value" lines are used and nothing is evaluated by the shell.
#
# Generated (under /run, rebuilt every boot):
#   /run/rdebugger/station.env                   EnvironmentFile for units
#   /run/rdebugger/openocd.cfg                   OpenOCD entry point
#   /run/rdebugger/ser2net.yaml                  ser2net configuration
#   /run/systemd/network/60-rdebugger-can.network  CAN bit rate for networkd
# and /etc/avahi/services/rdebugger.service (mDNS advertisement).

set -u

BOOT=/boot
DEFAULTS=/usr/lib/rdebugger/station.defaults
CONF=/etc/rdebugger/station.conf
RUN=/run/rdebugger
NETDIR=/run/systemd/network
WPA_CONF=/etc/wpa_supplicant/wpa_supplicant-nl80211-wlan0.conf
AVAHI_SERVICE=/etc/avahi/services/rdebugger.service
OPENOCD_CFG_DIR=/usr/share/rdebugger/openocd
OPENOCD_LOCAL_DIR=/etc/rdebugger/openocd

KNOWN_KEYS="STATION_NAME TARGET
    OPENOCD_RESET_CONFIG OPENOCD_BIND OPENOCD_ADAPTER_KHZ OPENOCD_GDB_PORT OPENOCD_TELNET_PORT OPENOCD_TCL_PORT
    DUT_UART_DEVICE DUT_UART_BAUD SER2NET_RAW_PORT SER2NET_RFC2217_PORT
    CAN_INTERFACE CAN_BITRATE CAN_RESTART_MS"
NUMERIC_KEYS="OPENOCD_GDB_PORT OPENOCD_TELNET_PORT OPENOCD_TCL_PORT
    DUT_UART_BAUD SER2NET_RAW_PORT SER2NET_RFC2217_PORT CAN_BITRATE CAN_RESTART_MS"

# stdout/stderr of the service go to the journal
log() { echo "rdebugger-setup: $*"; }

# Any failure is logged and makes the script (and its unit) exit non-zero.
rc=0
fail() { log "ERROR: $*"; rc=1; }

# Replace $1 with $1.new only if the content changed (avoids needless reloads).
# $2 = exit status of the command that wrote $1.new.
commit() {
    if [ "${2:-0}" != 0 ] || [ ! -f "$1.new" ]; then
        rm -f "$1.new"
        fail "could not write $1.new"
    elif [ -f "$1" ] && cmp -s "$1.new" "$1"; then
        rm -f "$1.new"
    elif mv -f "$1.new" "$1"; then
        log "wrote $1"
    else
        fail "could not replace $1"
    fi
}

# --- provisioning: files dropped onto the FAT boot partition ---------------
# Print $1 without CRs and without a leading UTF-8 byte order mark (Windows
# editors write both).
BOM=$(printf '\357\273\277')
clean() { tr -d '\r' < "$1" | sed "1s/^$BOM//"; }

import_boot_files() {
    [ -d "$BOOT" ] || return 0
    changed=0

    if [ -f "$BOOT/rdebugger.conf" ]; then
        if mkdir -p "$(dirname "$CONF")" &&
           clean "$BOOT/rdebugger.conf" > "$CONF.new" &&
           chmod 0644 "$CONF.new" && mv -f "$CONF.new" "$CONF"; then
            mv -f "$BOOT/rdebugger.conf" "$BOOT/rdebugger.conf.applied"
            log "imported station configuration from $BOOT/rdebugger.conf"
            changed=1
        else
            rm -f "$CONF.new"
            fail "could not import $BOOT/rdebugger.conf (left in place)"
        fi
    fi

    if [ -f "$BOOT/wpa_supplicant.conf" ]; then
        # Our own control socket line replaces any in the file: Raspberry Pi OS
        # examples use GROUP=netdev, a group this image does not have.
        if mkdir -p "$(dirname "$WPA_CONF")" &&
           (
               umask 077
               {
                   echo "ctrl_interface=/run/wpa_supplicant"
                   clean "$BOOT/wpa_supplicant.conf" | grep -v '^[[:space:]]*ctrl_interface='
               } > "$WPA_CONF.new"
           ) && chmod 0600 "$WPA_CONF.new" && mv -f "$WPA_CONF.new" "$WPA_CONF"; then
            # It holds a secret: never leave it on the FAT partition.
            rm -f "$BOOT/wpa_supplicant.conf"
            log "installed Wi-Fi configuration for wlan0 (removed from $BOOT)"
            changed=1
        else
            fail "could not install Wi-Fi configuration (left $BOOT/wpa_supplicant.conf in place)"
        fi
    fi

    if [ -f "$BOOT/authorized_keys" ]; then
        if mkdir -p /root/.ssh && chmod 0700 /root/.ssh && touch /root/.ssh/authorized_keys &&
           chmod 0600 /root/.ssh/authorized_keys; then
            # The loop runs in a subshell; its exit status is the pipeline's.
            if clean "$BOOT/authorized_keys" | while IFS= read -r key || [ -n "$key" ]; do
                case "$key" in ''|'#'*) continue ;; esac
                grep -qxF "$key" /root/.ssh/authorized_keys ||
                    echo "$key" >> /root/.ssh/authorized_keys || exit 1
            done; then
                mv -f "$BOOT/authorized_keys" "$BOOT/authorized_keys.applied"
                log "added SSH public keys for root from $BOOT/authorized_keys"
                changed=1
            else
                fail "could not add SSH keys (left $BOOT/authorized_keys in place)"
            fi
        else
            fail "could not install SSH keys (left $BOOT/authorized_keys in place)"
        fi
    fi

    [ "$changed" = 1 ] && sync
    return 0
}

# --- configuration ------------------------------------------------------------
# Parse KEY="value" lines from $1. Unknown keys are ignored with a warning.
read_conf() {
    [ -f "$1" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line=$(printf '%s' "$line" | tr -d '\r' | sed "s/^$BOM//")
        case "$line" in ''|'#'*|[[:space:]]'#'*) continue ;; esac
        case "$line" in *=*) ;; *) continue ;; esac
        key=$(printf '%s' "${line%%=*}" | tr -d ' \t')
        # Value: "quoted", 'quoted' or bare; anything after it (e.g. a
        # trailing # comment) is ignored. An unterminated quote gives "".
        raw=$(printf '%s' "${line#*=}" | sed -e 's/^[[:space:]]*//')
        case "$raw" in
            \"*) val=$(printf '%s' "$raw" | sed -n 's/^"\([^"]*\)".*$/\1/p') ;;
            \'*) val=$(printf '%s' "$raw" | sed -n "s/^'\([^']*\)'.*\$/\1/p") ;;
            *) val=$(printf '%s' "$raw" | sed -e 's/[[:space:]]*#.*$//' -e 's/[[:space:]]*$//') ;;
        esac
        case " $(echo $KNOWN_KEYS) " in
            *" $key "*) eval "$key=\$val" ;;
            *) log "ignoring unknown key '$key' in $1" ;;
        esac
    done < "$1"
}

load_config() {
    read_conf "$DEFAULTS"
    for k in $KNOWN_KEYS; do eval "DEF_$k=\${$k-}"; done
    read_conf "$CONF"
    validate
}

reset_key() {
    log "invalid $1='$2' in $CONF, using default"
    eval "$1=\$DEF_$1"
}

validate() {
    for k in $NUMERIC_KEYS; do
        eval "v=\${$k-}"
        case "$v" in ''|*[!0-9]*) reset_key "$k" "$v"; continue ;; esac
        case "$k" in
            *_PORT) [ "$v" -ge 1 ] && [ "$v" -le 65535 ] || reset_key "$k" "$v" ;;
            CAN_BITRATE) [ "$v" -ge 5000 ] && [ "$v" -le 1000000 ] || reset_key "$k" "$v" ;;
            DUT_UART_BAUD) [ "$v" -ge 50 ] && [ "$v" -le 12000000 ] || reset_key "$k" "$v" ;;
        esac
    done
    for k in OPENOCD_BIND DUT_UART_DEVICE CAN_INTERFACE; do
        eval "v=\${$k-}"
        case "$v" in ''|*[!A-Za-z0-9._/:-]*) reset_key "$k" "$v" ;; esac
    done
    # Any target with a shipped ($OPENOCD_CFG_DIR) or station-local
    # ($OPENOCD_LOCAL_DIR) <name>.cfg. The name ends up in a file path and in
    # the avahi XML, so only [a-z0-9_-] is accepted.
    case "$TARGET" in
        none) ;;
        ''|*[!a-z0-9_-]*) reset_key TARGET "$TARGET" ;;
        *) [ -f "$OPENOCD_LOCAL_DIR/$TARGET.cfg" ] || [ -f "$OPENOCD_CFG_DIR/$TARGET.cfg" ] ||
               reset_key TARGET "$TARGET" ;;
    esac
    case "$OPENOCD_RESET_CONFIG" in
        *[!a-z_\ ]*) reset_key OPENOCD_RESET_CONFIG "$OPENOCD_RESET_CONFIG" ;;
    esac
    case "$OPENOCD_ADAPTER_KHZ" in
        '') ;;
        *[!0-9]*|0*) reset_key OPENOCD_ADAPTER_KHZ "$OPENOCD_ADAPTER_KHZ" ;;
    esac
    STATION_NAME=$(printf '%s' "$STATION_NAME" | tr 'A-Z' 'a-z')
    case "$STATION_NAME" in
        *[!a-z0-9-]*|-*) reset_key STATION_NAME "$STATION_NAME" ;;
    esac
}

# --- identity -------------------------------------------------------------------
default_name() {
    serial=$(tr -d '\0' < /sys/firmware/devicetree/base/serial-number 2>/dev/null)
    [ -n "$serial" ] || serial=$(sed -n 's/^Serial[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo)
    serial=$(printf '%s' "$serial" | tr 'A-F' 'a-f' | tr -cd '0-9a-f')
    short=$(printf '%s' "$serial" | sed 's/.*\(........\)$/\1/')
    echo "rdebugger-${short:-unknown}"
}

set_hostname() {
    name=${STATION_NAME:-$(default_name)}
    name=$(printf '%s' "$name" | cut -c1-63)
    if [ "$(cat /etc/hostname 2>/dev/null)" != "$name" ]; then
        if echo "$name" > /etc/hostname; then
            log "static hostname set to $name"
        else
            fail "could not write /etc/hostname"
        fi
    fi
    [ "$(hostname)" = "$name" ] || hostname "$name" || fail "could not set hostname $name"
}

# --- generated runtime configuration ---------------------------------------------
generate() {
    mkdir -p "$RUN" "$NETDIR" || fail "could not create $RUN or $NETDIR"

    # Environment for the station's systemd units.
    {
        echo "# Generated by rdebugger-setup - do not edit."
        for k in $KNOWN_KEYS; do eval "echo \"$k=\\\"\${$k}\\\"\""; done
        echo "STATION_HOSTNAME=\"$(hostname)\""
    } > "$RUN/station.env.new"
    commit "$RUN/station.env" $?

    # CAN interface: systemd-networkd sets the bit rate and brings it up.
    cat > "$NETDIR/60-rdebugger-can.network.new" <<EOF
# Generated by rdebugger-setup from station.conf - do not edit.
[Match]
Name=$CAN_INTERFACE

[Link]
RequiredForOnline=no

[CAN]
BitRate=$CAN_BITRATE
RestartSec=${CAN_RESTART_MS}ms
EOF
    commit "$NETDIR/60-rdebugger-can.network" $?

    # ser2net: the DUT UART as raw TCP and as RFC 2217 (remote baud changes).
    cat > "$RUN/ser2net.yaml.new" <<EOF
%YAML 1.1
---
# Generated by rdebugger-setup from station.conf - do not edit.

connection: &dut-uart-raw
  accepter: tcp,$SER2NET_RAW_PORT
  connector: serialdev,$DUT_UART_DEVICE,${DUT_UART_BAUD}N81,local
  options:
    kickolduser: true

connection: &dut-uart-rfc2217
  accepter: telnet(rfc2217),tcp,$SER2NET_RFC2217_PORT
  connector: serialdev,$DUT_UART_DEVICE,${DUT_UART_BAUD}N81,local
  options:
    kickolduser: true
EOF
    commit "$RUN/ser2net.yaml" $?

    # OpenOCD entry point (absent when TARGET=none: the service then won't start).
    if [ "$TARGET" = none ]; then
        rm -f "$RUN/openocd.cfg"
    else
        {
            echo "# Generated by rdebugger-setup from station.conf - do not edit."
            echo "bindto $OPENOCD_BIND"
            echo "gdb port $OPENOCD_GDB_PORT"
            echo "telnet port $OPENOCD_TELNET_PORT"
            echo "tcl port $OPENOCD_TCL_PORT"
            # A station-local config in /etc/rdebugger/openocd/ overrides the shipped one.
            if [ -f "$OPENOCD_LOCAL_DIR/$TARGET.cfg" ]; then
                echo "source $OPENOCD_LOCAL_DIR/$TARGET.cfg"
            else
                echo "source $OPENOCD_CFG_DIR/$TARGET.cfg"
            fi
            [ -n "$OPENOCD_RESET_CONFIG" ] && echo "reset_config $OPENOCD_RESET_CONFIG"
            if [ -n "$OPENOCD_ADAPTER_KHZ" ]; then
                # The target scripts change the clock in their reset handlers
                # (reset-start, reset-init): append ours to those and to
                # reset-end, so the limit holds through every reset.
                echo "adapter speed $OPENOCD_ADAPTER_KHZ"
                printf 'foreach t [target names] { foreach e {reset-start reset-init reset-end} { set b [$t cget -event $e]; $t configure -event $e "$b\\nadapter speed %s" } }\n' "$OPENOCD_ADAPTER_KHZ"
            fi
            true
        } > "$RUN/openocd.cfg.new"
        commit "$RUN/openocd.cfg" $?
    fi

    # mDNS: advertise the station and its service ports for bench tooling.
    if [ -d "$(dirname "$AVAHI_SERVICE")" ]; then
        version=$(sed -n 's/^VERSION_ID=//p' /etc/os-release 2>/dev/null | tr -d '"')
        cat > "$AVAHI_SERVICE.new" <<EOF
<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Generated by rdebugger-setup from station.conf - do not edit. -->
<service-group>
  <name replace-wildcards="yes">%h</name>
  <service>
    <type>_rdebugger._tcp</type>
    <port>$OPENOCD_GDB_PORT</port>
    <txt-record>target=$TARGET</txt-record>
    <txt-record>gdb=$OPENOCD_GDB_PORT</txt-record>
    <txt-record>telnet=$OPENOCD_TELNET_PORT</txt-record>
    <txt-record>uart-raw=$SER2NET_RAW_PORT</txt-record>
    <txt-record>uart-rfc2217=$SER2NET_RFC2217_PORT</txt-record>
    <txt-record>socketcand=29536</txt-record>
    <txt-record>can-bitrate=$CAN_BITRATE</txt-record>
    <txt-record>version=$version</txt-record>
  </service>
</service-group>
EOF
        commit "$AVAHI_SERVICE" $?
    fi
}

show() {
    for k in $KNOWN_KEYS; do eval "printf '%-22s %s\n' $k \"\${$k}\""; done
    printf '%-22s %s\n' hostname "$(hostname)"
}

case "${1:-boot}" in
    boot)
        import_boot_files
        load_config
        set_hostname
        generate
        ;;
    apply)
        import_boot_files
        load_config
        set_hostname
        generate
        networkctl reload 2>/dev/null && networkctl reconfigure "$CAN_INTERFACE" 2>/dev/null
        systemctl try-restart avahi-daemon.service ser2net.service socketcand.service \
            socketcand-proxy.service rdebugger-openocd.service
        # Wi-Fi provisioned or changed: (re)start the client if wlan0 exists.
        if [ -f "$WPA_CONF" ] && [ -e /sys/class/net/wlan0 ]; then
            systemctl restart wpa_supplicant-nl80211@wlan0.service
        fi
        # OpenOCD may have been stopped by TARGET=none; start it again if a probe is present.
        if [ "$TARGET" != none ] && systemctl -q is-active sys-subsystem-usb-devices-stlink.device; then
            systemctl start rdebugger-openocd.service
        fi
        [ "$rc" = 0 ] && log "configuration applied" || log "configuration applied with errors"
        ;;
    show)
        load_config
        show
        ;;
    *)
        echo "usage: rdebugger-setup [boot|apply|show]" >&2
        exit 2
        ;;
esac
exit "$rc"

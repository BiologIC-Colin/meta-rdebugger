[Unit]
Description=Grow the root filesystem to fill the eMMC (first boot)
DefaultDependencies=no
After=local-fs.target systemd-remount-fs.service
Before=shutdown.target
Conflicts=shutdown.target
ConditionPathExists=!/var/lib/rdebugger/growfs.done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/rdebugger-growfs

[Install]
WantedBy=multi-user.target

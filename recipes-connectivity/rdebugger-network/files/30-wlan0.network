# rdebugger: optional Wi-Fi (credentials provisioned via wpa_supplicant.conf
# on the boot partition). Never blocks network-online.target.
[Match]
Name=wlan0

[Network]
DHCP=yes
MulticastDNS=no
LLMNR=no

[DHCPv4]
RouteMetric=600
UseHostname=no
SendHostname=yes

[IPv6AcceptRA]
RouteMetric=600

[Link]
RequiredForOnline=no
